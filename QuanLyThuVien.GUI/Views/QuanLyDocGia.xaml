<UserControl x:Class="QuanLyThuVien.GUI.Views.QuanLyDocGia"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="13">

            <!-- Tiêu đề -->
            <TextBlock Text="QUẢN LÝ ĐỘC GIẢ"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#3B82F6"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Quản lý thông tin thành viên thư viện"
                       FontSize="13"
                       Foreground="#D1D5DB"
                       Margin="0,0,0,18"/>

            <!-- Khu vực thông tin độc giả -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,0,18">

                <StackPanel>

                    <TextBlock Text="THÔNG TIN ĐỘC GIẢ"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               Margin="0,0,0,12"/>

                    <UniformGrid Columns="2">

                        <!-- Mã độc giả -->
                        <StackPanel Margin="5">
                            <TextBlock Text="Mã độc giả *"
                                       Foreground="#374151"
                                       FontSize="12"/>

                            <TextBox x:Name="txtMaDocGia"
                                     Height="32"
                                     MaxLength="10"
                                     Margin="0,5,10,8"
                                     Padding="7,0"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Họ tên -->
                        <StackPanel Margin="5">
                            <TextBlock Text="Họ và tên *"
                                       Foreground="#374151"
                                       FontSize="12"/>

                            <TextBox x:Name="txtHoTen"
                                     Height="32"
                                     MaxLength="100"
                                     Margin="0,5,10,8"
                                     Padding="7,0"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Số điện thoại -->
                        <StackPanel Margin="5">
                            <TextBlock Text="Số điện thoại"
                                       Foreground="#374151"
                                       FontSize="12"/>

                            <TextBox x:Name="txtSoDienThoai"
                                     Height="32"
                                     MaxLength="15"
                                     Margin="0,5,10,8"
                                     Padding="7,0"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Địa chỉ -->
                        <StackPanel Margin="5">
                            <TextBlock Text="Địa chỉ"
                                       Foreground="#374151"
                                       FontSize="12"/>

                            <TextBox x:Name="txtDiaChi"
                                     Height="32"
                                     MaxLength="200"
                                     Margin="0,5,10,8"
                                     Padding="7,0"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                    </UniformGrid>

                    <!-- Nút chức năng -->
                    <WrapPanel Margin="5,8,0,0">

                        <Button Content="Thêm độc giả"
                                Width="120"
                                Height="34"
                                Margin="0,0,10,5"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="ThemDocGia_Click"/>

                        <Button Content="Sửa thông tin"
                                Width="120"
                                Height="34"
                                Margin="0,0,10,5"
                                Background="#D97706"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="SuaDocGia_Click"/>

                        <Button Content="Xóa độc giả"
                                Width="120"
                                Height="34"
                                Margin="0,0,10,5"
                                Background="#DC2626"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="XoaDocGia_Click"/>

                        <Button Content="Nhập lại"
                                Width="100"
                                Height="34"
                                Margin="0,0,10,5"
                                Background="#6B7280"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="NhapLai_Click"/>

                    </WrapPanel>

                    <TextBlock x:Name="txtThongBaoDG"
                               Foreground="#16A34A"
                               FontSize="12"
                               Margin="5,8,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <!-- Danh sách độc giả -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="18">

                <StackPanel>

                    <TextBlock Text="DANH SÁCH ĐỘC GIẢ"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               Margin="0,0,0,12"/>

                    <!-- Tìm kiếm -->
                    <WrapPanel Margin="0,0,0,12">

                        <TextBox x:Name="txtTimKiemDG"
                                 Width="250"
                                 Height="32"
                                 Padding="7,0"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,10,5"/>

                        <Button Content="Tìm kiếm"
                                Width="100"
                                Height="32"
                                Margin="0,0,10,5"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="TimKiemDG_Click"/>

                        <Button Content="Hiển thị tất cả"
                                Width="120"
                                Height="32"
                                Margin="0,0,10,5"
                                Background="#6B7280"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="HienTatCaDG_Click"/>

                    </WrapPanel>

                    <!-- Bảng dữ liệu -->
                    <DataGrid x:Name="dgDocGia"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Height="300"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB"
                              RowHeight="28"
                              ColumnHeaderHeight="32"
                              FontSize="12"
                              Background="White"
                              Foreground="#374151"
                              BorderBrush="#E5E7EB"
                              BorderThickness="1"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="dgDocGia_SelectionChanged">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"
                                        Value="#F3F4F6"/>
                                <Setter Property="Foreground"
                                        Value="#172B4D"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                                <Setter Property="Padding"
                                        Value="8,5"/>
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Left"/>
                                <Setter Property="BorderBrush"
                                        Value="#E5E7EB"/>
                                <Setter Property="BorderThickness"
                                        Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding"
                                        Value="8,4"/>
                                <Setter Property="BorderThickness"
                                        Value="0"/>
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background"
                                        Value="White"/>
                                <Setter Property="Foreground"
                                        Value="#374151"/>
                                <Setter Property="BorderBrush"
                                        Value="#E5E7EB"/>
                                <Setter Property="BorderThickness"
                                        Value="0,0,0,1"/>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#EFF6FF"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#DBEAFE"/>
                                        <Setter Property="Foreground"
                                                Value="#172B4D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Mã độc giả"
                                                Binding="{Binding MaDocGia}"
                                                Width="100"
                                                MinWidth="100"/>

                            <DataGridTextColumn Header="Họ và tên"
                                                Binding="{Binding TenDocGia}"
                                                Width="2*"
                                                MinWidth="150"/>

                            <DataGridTextColumn Header="Số điện thoại"
                                                Binding="{Binding SoDienThoai}"
                                                Width="130"
                                                MinWidth="120"/>

                            <DataGridTextColumn Header="Địa chỉ"
                                                Binding="{Binding DiaChi}"
                                                Width="2*"
                                                MinWidth="150"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>
