<UserControl x:Class="QuanLyThuVien.GUI.Views.QuanLyMuonTra"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <TextBlock Text="QUẢN LÝ MƯỢN TRẢ"
                       FontSize="26" FontWeight="Bold"
                       Foreground="#172B4D"/>

            <TextBlock Text="Theo dõi phiếu mượn và tình trạng trả sách"
                       Foreground="#718096" Margin="0,8,0,20"/>

            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="THÔNG TIN PHIẾU MƯỢN"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#172B4D" Margin="0,0,0,15"/>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="5">
                            <TextBlock Text="Mã độc giả"/>
                            <TextBox x:Name="txtMaDocGia" Height="32" Margin="0,5,10,10"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Tên độc giả"/>
                            <TextBox x:Name="txtTenDocGia" Height="32" Margin="0,5,10,10"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Tên sách"/>
                            <TextBox x:Name="txtTenSach" Height="32" Margin="0,5,10,10"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Ngày mượn (dd/MM/yyyy)"/>
                            <TextBox x:Name="txtNgayMuon" Height="32" Margin="0,5,10,10"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Ngày hẹn trả (dd/MM/yyyy)"/>
                            <TextBox x:Name="txtNgayHenTra" Height="32" Margin="0,5,10,10"/>
                        </StackPanel>
                    </UniformGrid>

                    <WrapPanel Margin="5,10,0,0">
                        <Button Content="Tạo phiếu mượn" Width="130" Height="35"
                                Margin="0,0,10,5" Click="TaoPhieu_Click"/>
                        <Button Content="Xác nhận trả" Width="120" Height="35"
                                Margin="0,0,10,5" Click="XacNhanTra_Click"/>
                        <Button Content="Xóa phiếu" Width="110" Height="35"
                                Margin="0,0,10,5" Click="XoaPhieu_Click"/>
                        <Button Content="Nhập lại" Width="100" Height="35"
                                Margin="0,0,10,5" Click="NhapLai_Click"/>
                    </WrapPanel>

                    <TextBlock x:Name="txtThongBaoMT" Foreground="#16A34A"
                               Margin="5,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="DANH SÁCH PHIẾU MƯỢN"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#172B4D" Margin="0,0,0,15"/>

                    <WrapPanel Margin="0,0,0,15">
                        <TextBox x:Name="txtTimKiemMT" Width="250" Height="32"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,10,5"/>
                        <Button Content="Tìm kiếm" Width="100" Height="32"
                                Margin="0,0,10,5" Click="TimKiemMT_Click"/>
                        <Button Content="Hiển thị tất cả" Width="120" Height="32"
                                Margin="0,0,10,5" Click="HienTatCaMT_Click"/>
                    </WrapPanel>

                    <DataGrid x:Name="dgMuonTra" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" Height="280"
                              SelectionChanged="dgMuonTra_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã phiếu" Binding="{Binding MaPhieu}" Width="*"/>
                            <DataGridTextColumn Header="Mã độc giả" Binding="{Binding MaDocGia}" Width="*"/>
                            <DataGridTextColumn Header="Tên độc giả" Binding="{Binding TenDocGia}" Width="2*"/>
                            <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" Width="2*"/>
                            <DataGridTextColumn Header="Ngày mượn" Binding="{Binding NgayMuon}" Width="*"/>
                            <DataGridTextColumn Header="Ngày hẹn trả" Binding="{Binding NgayHenTra}" Width="*"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding TrangThai}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
