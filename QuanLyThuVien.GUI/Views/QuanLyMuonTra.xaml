<UserControl x:Class="QuanLyThuVien.GUI.Views.QuanLyMuonTra"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1B1B1B">

    <UserControl.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,3"/>
        </Style>

        <Style x:Key="BtnBlue" TargetType="Button"
               BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#2563EB"/>
        </Style>

        <Style x:Key="BtnOrange" TargetType="Button"
               BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#D97706"/>
        </Style>

        <Style x:Key="BtnRed" TargetType="Button"
               BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <Style x:Key="BtnGray" TargetType="Button"
               BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#D1D5DB"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RowHeight" Value="27"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="13">

            <TextBlock Text="QUẢN LÝ MƯỢN TRẢ"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#2563EB"/>

            <TextBlock Text="Theo dõi phiếu mượn và tình trạng trả sách"
                       FontSize="10"
                       Foreground="#718096"
                       Margin="0,3,0,10"/>

            <!-- THONG TIN PHIEU MUON -->
            <Border Background="White"
                    CornerRadius="7"
                    Padding="12"
                    Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="THÔNG TIN PHIẾU MƯỢN"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               Margin="0,0,0,8"/>

                    <UniformGrid Columns="2">

                        <StackPanel Margin="0,3,5,3">
                            <TextBlock Text="Mã phiếu *" FontSize="10"/>
                            <TextBox x:Name="txtMaPhieu"
                                     MaxLength="10"
                                     Margin="0,3,0,5"/>
                        </StackPanel>

                        <StackPanel Margin="5,3,0,3">
                            <TextBlock Text="Mã độc giả *" FontSize="10"/>
                            <TextBox x:Name="txtMaDocGia"
                                     MaxLength="10"
                                     Margin="0,3,0,5"/>
                        </StackPanel>

                        <StackPanel Margin="0,3,5,3">
                            <TextBlock Text="Mã sách *" FontSize="10"/>
                            <TextBox x:Name="txtMaSach"
                                     MaxLength="10"
                                     Margin="0,3,0,5"/>
                        </StackPanel>

                        <StackPanel Margin="5,3,0,3">
                            <TextBlock Text="Số lượng mượn" FontSize="10"/>
                            <TextBox x:Name="txtSoLuongMuon"
                                     Margin="0,3,0,5"/>
                        </StackPanel>

                        <StackPanel Margin="0,3,5,3">
                            <TextBlock Text="Ngày mượn" FontSize="10"/>
                            <TextBox x:Name="txtNgayMuon"
                                     ToolTip="Định dạng dd/MM/yyyy"
                                     Margin="0,3,0,5"/>
                        </StackPanel>

                        <StackPanel Margin="5,3,0,3">
                            <TextBlock Text="Hạn trả" FontSize="10"/>
                            <TextBox x:Name="txtHanTra"
                                     ToolTip="Định dạng dd/MM/yyyy"
                                     Margin="0,3,0,5"/>
                        </StackPanel>

                        <StackPanel Margin="0,3,5,3">
                            <TextBlock Text="Ngày trả" FontSize="10"/>
                            <TextBox x:Name="txtNgayTra"
                                     ToolTip="Định dạng dd/MM/yyyy"
                                     Margin="0,3,0,5"/>
                        </StackPanel>

                        <StackPanel Margin="5,3,0,3">
                            <TextBlock Text="Tiền phạt" FontSize="10"/>
                            <TextBox x:Name="txtTienPhat"
                                     Margin="0,3,0,5"/>
                        </StackPanel>

                    </UniformGrid>

                    <WrapPanel Margin="0,5,0,0">

                        <Button Content="Tạo phiếu mượn"
                                Width="105"
                                Style="{StaticResource BtnBlue}"
                                Click="TaoPhieu_Click"/>

                        <Button Content="Xác nhận trả"
                                Width="95"
                                Style="{StaticResource BtnOrange}"
                                Click="XacNhanTra_Click"/>

                        <Button Content="Xóa phiếu"
                                Width="85"
                                Style="{StaticResource BtnRed}"
                                Click="XoaPhieu_Click"/>

                        <Button Content="Nhập lại"
                                Width="75"
                                Style="{StaticResource BtnGray}"
                                Click="NhapLai_Click"/>

                    </WrapPanel>

                    <TextBlock x:Name="txtThongBaoMT"
                               FontSize="10"
                               Foreground="#16A34A"
                               Margin="3,7,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <!-- DANH SACH PHIEU MUON -->
            <Border Background="White"
                    CornerRadius="7"
                    Padding="12">

                <StackPanel>

                    <TextBlock Text="DANH SÁCH PHIẾU MƯỢN"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               Margin="0,0,0,10"/>

                    <WrapPanel Margin="0,0,0,8">

                        <TextBox x:Name="txtTimKiemMT"
                                 Width="145"
                                 Height="26"
                                 Margin="0,0,5,3"
                                 ToolTip="Nhập mã phiếu, mã độc giả hoặc mã sách"/>

                        <Button Content="Tìm kiếm"
                                Width="65"
                                Height="26"
                                FontSize="9"
                                Margin="0,0,5,3"
                                Background="#D1D5DB"
                                Foreground="#333333"
                                BorderThickness="0"
                                Click="TimKiemMT_Click"/>

                        <Button Content="Hiển thị tất cả"
                                Width="90"
                                Height="26"
                                FontSize="9"
                                Margin="0,0,0,3"
                                Background="#D1D5DB"
                                Foreground="#333333"
                                BorderThickness="0"
                                Click="HienTatCaMT_Click"/>

                    </WrapPanel>

                    <DataGrid x:Name="dgMuonTra"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              Height="220"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="dgMuonTra_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Mã phiếu"
                                Binding="{Binding MaPhieu}"
                                Width="95" MinWidth="90"/>

                            <DataGridTextColumn Header="Mã độc giả"
                                Binding="{Binding MaDocGia}"
                                Width="105" MinWidth="100"/>

                            <DataGridTextColumn Header="Mã sách"
                                Binding="{Binding MaSach}"
                                Width="95" MinWidth="90"/>

                            <DataGridTextColumn Header="Số lượng"
                                Binding="{Binding SoLuongMuon}"
                                Width="85" MinWidth="80"/>

                            <DataGridTextColumn Header="Ngày mượn"
                                Binding="{Binding NgayMuon}"
                                Width="105" MinWidth="100"/>

                            <DataGridTextColumn Header="Hạn trả"
                                Binding="{Binding HanTra}"
                                Width="105" MinWidth="100"/>

                            <DataGridTextColumn Header="Ngày trả"
                                Binding="{Binding NgayTra}"
                                Width="105" MinWidth="100"/>

                            <DataGridTextColumn Header="Trạng thái"
                                Binding="{Binding TrangThai}"
                                Width="105" MinWidth="100"/>

                            <DataGridTextColumn Header="Tiền phạt"
                                Binding="{Binding TienPhat}"
                                Width="105" MinWidth="100"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
