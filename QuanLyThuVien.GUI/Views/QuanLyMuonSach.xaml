<UserControl x:Class="QuanLyThuVien.GUI.Views.QuanLyMuonSach"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <TextBlock Text="QUẢN LÝ SÁCH"
                       FontSize="26" FontWeight="Bold"
                       Foreground="#172B4D"/>

            <TextBlock Text="Quản lý thông tin và số lượng sách trong thư viện"
                       Foreground="#718096" Margin="0,8,0,20"/>

            <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="THÔNG TIN SÁCH"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#172B4D" Margin="0,0,0,15"/>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="5">
                            <TextBlock Text="Tên sách"/>
                            <TextBox x:Name="txtTenSach" Height="32" Margin="0,5,10,10"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Tác giả"/>
                            <TextBox x:Name="txtTacGia" Height="32" Margin="0,5,10,10"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Thể loại"/>
                            <TextBox x:Name="txtTheLoai" Height="32" Margin="0,5,10,10"/>
                        </StackPanel>
                        <StackPanel Margin="5">
                            <TextBlock Text="Số lượng"/>
                            <TextBox x:Name="txtSoLuong" Height="32" Margin="0,5,10,10"/>
                        </StackPanel>
                    </UniformGrid>

                    <WrapPanel Margin="5,10,0,0">
                        <Button Content="Thêm sách" Width="110" Height="35"
                                Margin="0,0,10,5" Click="ThemSach_Click"/>
                        <Button Content="Sửa sách" Width="110" Height="35"
                                Margin="0,0,10,5" Click="SuaSach_Click"/>
                        <Button Content="Xóa sách" Width="110" Height="35"
                                Margin="0,0,10,5" Click="XoaSach_Click"/>
                        <Button Content="Nhập lại" Width="110" Height="35"
                                Margin="0,0,10,5" Click="NhapLai_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="txtThongBao" Foreground="#16A34A"
                               Margin="5,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="DANH SÁCH SÁCH"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#172B4D" Margin="0,0,0,15"/>

                    <WrapPanel Margin="0,0,0,15">
                        <TextBox x:Name="txtTimKiem" Width="250" Height="32"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,10,5"/>
                        <Button Content="Tìm kiếm" Width="100" Height="32"
                                Margin="0,0,10,5" Click="TimKiem_Click"/>
                        <Button Content="Hiển thị tất cả" Width="120" Height="32"
                                Margin="0,0,10,5" Click="HienTatCa_Click"/>
                    </WrapPanel>

                    <DataGrid x:Name="dgSach" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" Height="280"
                              SelectionChanged="dgSach_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã sách" Binding="{Binding MaSach}" Width="*"/>
                            <DataGridTextColumn Header="Tên sách" Binding="{Binding TenSach}" Width="2*"/>
                            <DataGridTextColumn Header="Tác giả" Binding="{Binding TacGia}" Width="2*"/>
                            <DataGridTextColumn Header="Thể loại" Binding="{Binding TheLoai}" Width="*"/>
                            <DataGridTextColumn Header="Số lượng" Binding="{Binding SoLuong}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
