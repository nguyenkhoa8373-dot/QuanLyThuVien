<UserControl x:Class="QuanLyThuVien.GUI.Views.QuanLyMuonSach"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1B1B1B">

    <UserControl.Resources>

        <!-- O NHAP LIEU -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="25"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- NUT CHUC NANG -->
        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Height" Value="27"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="2,3"/>
        </Style>

        <Style x:Key="BtnBlue" TargetType="Button"
               BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#2563EB"/>
        </Style>

        <Style x:Key="BtnOrange" TargetType="Button"
               BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#D97706"/>
        </Style>

        <Style x:Key="BtnRed" TargetType="Button"
               BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <Style x:Key="BtnGray" TargetType="Button"
               BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="#D1D5DB"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- DATA GRID -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RowHeight" Value="27"/>
            <Setter Property="ColumnHeaderHeight" Value="30"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5E7EB"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="13">

            <TextBlock Text="QUẢN LÝ SÁCH"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#2563EB"/>

            <TextBlock Text="Quản lý thông tin và số lượng sách trong thư viện"
                       FontSize="10"
                       Foreground="#718096"
                       Margin="0,3,0,10"/>

            <!-- THONG TIN SACH -->
            <Border Background="White"
                    CornerRadius="7"
                    Padding="12"
                    Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="THÔNG TIN SÁCH"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               Margin="0,0,0,8"/>

                    <UniformGrid Columns="2">

                        <StackPanel Margin="0,3,5,3">
                            <TextBlock Text="Mã sách *" FontSize="10"/>
                            <TextBox x:Name="txtMaSach"
                                     MaxLength="10"
                                     Margin="0,3,0,5"/>
                        </StackPanel>

                        <StackPanel Margin="5,3,0,3">
                            <TextBlock Text="Tên sách *" FontSize="10"/>
                            <TextBox x:Name="txtTenSach"
                                     MaxLength="100"
                                     Margin="0,3,0,5"/>
                        </StackPanel>

                        <StackPanel Margin="0,3,5,3">
                            <TextBlock Text="Thể loại" FontSize="10"/>
                            <TextBox x:Name="txtTheLoai"
                                     MaxLength="50"
                                     Margin="0,3,0,5"/>
                        </StackPanel>

                        <StackPanel Margin="5,3,0,3">
                            <TextBlock Text="Số lượng tồn" FontSize="10"/>
                            <TextBox x:Name="txtSoLuong"
                                     Margin="0,3,0,5"/>
                        </StackPanel>

                    </UniformGrid>

                    <WrapPanel Margin="0,5,0,0">

                        <Button Content="Thêm sách"
                                Width="85"
                                Style="{StaticResource BtnBlue}"
                                Click="ThemSach_Click"/>

                        <Button Content="Sửa thông tin"
                                Width="95"
                                Style="{StaticResource BtnOrange}"
                                Click="SuaSach_Click"/>

                        <Button Content="Xóa sách"
                                Width="85"
                                Style="{StaticResource BtnRed}"
                                Click="XoaSach_Click"/>

                        <Button Content="Nhập lại"
                                Width="75"
                                Style="{StaticResource BtnGray}"
                                Click="NhapLai_Click"/>

                    </WrapPanel>

                    <TextBlock x:Name="txtThongBao"
                               FontSize="10"
                               Foreground="#374151"
                               Margin="3,7,0,0"
                               TextWrapping="Wrap"/>

                </StackPanel>
            </Border>

            <!-- DANH SACH SACH -->
            <Border Background="White"
                    CornerRadius="7"
                    Padding="12">

                <StackPanel>

                    <TextBlock Text="DANH SÁCH SÁCH"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               Margin="0,0,0,10"/>

                    <WrapPanel Margin="0,0,0,8">

                        <TextBox x:Name="txtTimKiem"
                                 Width="145"
                                 Height="26"
                                 Margin="0,0,5,3"
                                 ToolTip="Nhập mã sách hoặc tên sách"/>

                        <Button Content="Tìm kiếm"
                                Width="65"
                                Height="26"
                                FontSize="9"
                                Margin="0,0,5,3"
                                Background="#D1D5DB"
                                Foreground="#333333"
                                BorderThickness="0"
                                Click="TimKiem_Click"/>

                        <Button Content="Hiển thị tất cả"
                                Width="90"
                                Height="26"
                                FontSize="9"
                                Margin="0,0,0,3"
                                Background="#D1D5DB"
                                Foreground="#333333"
                                BorderThickness="0"
                                Click="HienTatCa_Click"/>

                    </WrapPanel>

                    <DataGrid x:Name="dgSach"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              MinHeight="220"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionChanged="dgSach_SelectionChanged">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Mã sách"
                                Binding="{Binding MaSach}"
                                Width="100"
                                MinWidth="90"/>

                            <DataGridTextColumn Header="Tên sách"
                                Binding="{Binding TenSach}"
                                Width="220"
                                MinWidth="160"/>

                            <DataGridTextColumn Header="Thể loại"
                                Binding="{Binding TheLoai}"
                                Width="130"
                                MinWidth="100"/>

                            <DataGridTextColumn Header="Số lượng tồn"
                                Binding="{Binding SoLuongTon}"
                                Width="110"
                                MinWidth="100"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>