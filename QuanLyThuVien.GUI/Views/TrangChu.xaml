<UserControl x:Class="QuanLyThuVien.GUI.Views.TrangChu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="13">

            <!-- Tiêu đề -->
            <TextBlock Text="TỔNG QUAN THƯ VIỆN"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#3B82F6"
                       Margin="0,0,0,5"/>

            <TextBlock Text="Chào mừng đến với hệ thống quản lý thư viện"
                       FontSize="13"
                       Foreground="#D1D5DB"
                       Margin="0,0,0,18"/>

            <!-- Các thẻ thống kê -->
            <UniformGrid Columns="4"
                         Margin="0,0,0,15">

                <!-- Tổng số sách -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="15"
                        Margin="4">

                    <StackPanel>
                        <TextBlock Text="TỔNG SỐ SÁCH"
                                   Foreground="#718096"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtTongSach"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   Margin="0,10,0,5"/>

                        <TextBlock Text="Đầu sách trong thư viện"
                                   Foreground="#718096"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Tổng độc giả -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="15"
                        Margin="4">

                    <StackPanel>
                        <TextBlock Text="ĐỘC GIẢ"
                                   Foreground="#718096"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtTongDocGia"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0,10,0,5"/>

                        <TextBlock Text="Độc giả đã đăng ký"
                                   Foreground="#718096"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Đang mượn -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="15"
                        Margin="4">

                    <StackPanel>
                        <TextBlock Text="ĐANG MƯỢN"
                                   Foreground="#718096"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtDangMuon"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#D97706"
                                   Margin="0,10,0,5"/>

                        <TextBlock Text="Lượt mượn chưa trả"
                                   Foreground="#718096"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

                <!-- Quá hạn -->
                <Border Background="White"
                        CornerRadius="10"
                        Padding="15"
                        Margin="4">

                    <StackPanel>
                        <TextBlock Text="QUÁ HẠN"
                                   Foreground="#718096"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="txtQuaHan"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   Margin="0,10,0,5"/>

                        <TextBlock Text="Lượt mượn quá hạn"
                                   Foreground="#718096"
                                   FontSize="11"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- Hoạt động gần đây -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,0,15">

                <StackPanel>

                    <TextBlock Text="HOẠT ĐỘNG GẦN ĐÂY"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               Margin="0,0,0,12"/>

                    <DataGrid x:Name="dgHoatDong"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MinHeight="210"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB"
                              RowHeight="28"
                              ColumnHeaderHeight="32"
                              FontSize="12"
                              Background="White"
                              Foreground="#374151"
                              BorderBrush="#E5E7EB"
                              BorderThickness="1"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"
                                        Value="#F3F4F6"/>
                                <Setter Property="Foreground"
                                        Value="#172B4D"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                                <Setter Property="Padding"
                                        Value="8,5"/>
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Left"/>
                                <Setter Property="BorderBrush"
                                        Value="#E5E7EB"/>
                                <Setter Property="BorderThickness"
                                        Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding"
                                        Value="8,4"/>
                                <Setter Property="BorderThickness"
                                        Value="0"/>
                                <Setter Property="VerticalContentAlignment"
                                        Value="Center"/>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background"
                                        Value="White"/>
                                <Setter Property="Foreground"
                                        Value="#374151"/>
                                <Setter Property="BorderBrush"
                                        Value="#E5E7EB"/>
                                <Setter Property="BorderThickness"
                                        Value="0,0,0,1"/>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#EFF6FF"/>
                                    </Trigger>

                                    <Trigger Property="IsSelected"
                                             Value="True">
                                        <Setter Property="Background"
                                                Value="#DBEAFE"/>
                                        <Setter Property="Foreground"
                                                Value="#172B4D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Mã phiếu"
                                                Binding="{Binding MaPhieu}"
                                                Width="*"
                                                MinWidth="90"/>

                            <DataGridTextColumn Header="Mã độc giả"
                                                Binding="{Binding MaDocGia}"
                                                Width="*"
                                                MinWidth="100"/>

                            <DataGridTextColumn Header="Mã sách"
                                                Binding="{Binding MaSach}"
                                                Width="*"
                                                MinWidth="90"/>

                            <!-- SỬA: bind NgayMuonText (string dd/MM/yyyy) thay vì NgayMuon (DateTime) -->
                            <DataGridTextColumn Header="Ngày mượn"
                                                Binding="{Binding NgayMuonText}"
                                                Width="*"
                                                MinWidth="110"/>

                            <DataGridTextColumn Header="Trạng thái"
                                                Binding="{Binding TrangThai}"
                                                Width="*"
                                                MinWidth="110"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </StackPanel>
            </Border>

            <!-- Thông báo -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="THÔNG BÁO"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               Margin="0,0,0,12"/>

                    <Border Background="#EFF6FF"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,3">

                        <TextBlock x:Name="txtThongBao1"
                                   FontSize="13"
                                   Foreground="#1D4ED8"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Background="#F0FDF4"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,3">

                        <TextBlock x:Name="txtThongBao2"
                                   FontSize="13"
                                   Foreground="#15803D"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Background="#FEF2F2"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,3">

                        <TextBlock x:Name="txtThongBao3"
                                   FontSize="13"
                                   Foreground="#B91C1C"
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>

</UserControl>