<UserControl x:Class="QuanLyThuVien.GUI.Views.TrangChu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <!-- TIEU DE -->
            <TextBlock Text="TỔNG QUAN THƯ VIỆN"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#172B4D"/>

            <TextBlock Text="Chào mừng đến với hệ thống quản lý thư viện"
                       FontSize="14"
                       Foreground="#718096"
                       Margin="0,8,0,25"/>

            <!-- CAC THE THONG KE -->
            <UniformGrid Columns="4" Margin="0,0,0,25">

                <Border Background="White" CornerRadius="10"
                        Padding="18" Margin="5">
                    <StackPanel>
                        <TextBlock Text="TỔNG SỐ SÁCH"
                                   Foreground="#718096"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="1.836"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#2563EB"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Đầu sách trong thư viện"
                                   Foreground="#718096"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10"
                        Padding="18" Margin="5">
                    <StackPanel>
                        <TextBlock Text="ĐỘC GIẢ"
                                   Foreground="#718096"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="360"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Độc giả đã đăng ký"
                                   Foreground="#718096"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10"
                        Padding="18" Margin="5">
                    <StackPanel>
                        <TextBlock Text="ĐANG MƯỢN"
                                   Foreground="#718096"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="36"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#D97706"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Lượt mượn chưa trả"
                                   Foreground="#718096"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10"
                        Padding="18" Margin="5">
                    <StackPanel>
                        <TextBlock Text="QUÁ HẠN"
                                   Foreground="#718096"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="18"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Lượt mượn quá hạn"
                                   Foreground="#718096"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- HOAT DONG GAN DAY -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="5,0,5,20">

                <StackPanel>
                    <TextBlock Text="HOẠT ĐỘNG GẦN ĐÂY"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               Margin="0,0,0,15"/>

                    <DataGrid x:Name="dgHoatDong"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              Height="210"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã độc giả"
                                                Binding="{Binding MaDocGia}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Tên độc giả"
                                                Binding="{Binding TenDocGia}"
                                                Width="2*"/>
                            <DataGridTextColumn Header="Tên sách"
                                                Binding="{Binding TenSach}"
                                                Width="2*"/>
                            <DataGridTextColumn Header="Ngày mượn"
                                                Binding="{Binding NgayMuon}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Trạng thái"
                                                Binding="{Binding TrangThai}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- THONG BAO -->
            <Border Background="White"
                    CornerRadius="10"
                    Padding="20"
                    Margin="5,0,5,10">

                <StackPanel>
                    <TextBlock Text="THÔNG BÁO"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#172B4D"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="• Có 18 lượt mượn sách đã quá hạn."
                               FontSize="14"
                               Margin="0,5"/>

                    <TextBlock Text="• Có 18 đầu sách sắp hết số lượng."
                               FontSize="14"
                               Margin="0,5"/>

                    <TextBlock Text="• Hệ thống đang hoạt động bình thường."
                               FontSize="14"
                               Margin="0,5"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
