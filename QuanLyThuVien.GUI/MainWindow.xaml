<Window x:Class="QuanLyThuVien.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QUẢN LÝ THƯ VIỆN"
        Height="750"
        Width="1200"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#F3F6FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- MENU BEN TRAI -->
        <Border Grid.Column="0" Background="#172B4D">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,30,20,20">
                    <TextBlock Text="LIBRARY"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="MANAGEMENT SYSTEM"
                               Foreground="#AFC3E2"
                               FontSize="10"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Margin="12,20,12,0">
                    <Button Content="Trang chủ"
                            Height="48"
                            Margin="0,5"
                            Click="TrangChu_Click"/>

                    <Button Content="Quản lý sách"
                            Height="48"
                            Margin="0,5"
                            Click="QuanLySach_Click"/>

                    <Button Content="Quản lý độc giả"
                            Height="48"
                            Margin="0,5"
                            Click="QuanLyDocGia_Click"/>

                    <Button Content="Quản lý mượn trả"
                            Height="48"
                            Margin="0,5"
                            Click="QuanLyMuonTra_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- KHU VUC HIEN THI -->
        <Grid Grid.Column="1">
            <ContentControl x:Name="MainContent"/>
        </Grid>
    </Grid>
</Window>
